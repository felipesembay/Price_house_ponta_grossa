{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Monitoramento de Data Drift — Modelo de Precificação de Imóveis",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Dataset Drift Detectado",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "text": "OK" }, "1": { "color": "red", "text": "DRIFT!" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "targets": [
        {
          "expr": "dataset_drift_detected",
          "legendFormat": "{{modelo}} v{{versao}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Features com Drift (%)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "share_drifted_columns",
          "legendFormat": "{{modelo}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Última Atualização",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "last_drift_run_timestamp * 1000",
          "legendFormat": "Último run",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 10,
      "type": "bargauge",
      "title": "Drift Score por Feature (último valor)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.10 },
              { "color": "orange", "value": 0.20 },
              { "color": "red", "value": 0.30 }
            ]
          },
          "unit": "short",
          "decimals": 4
        }
      },
      "targets": [
        {
          "expr": "feature_drift_score",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Evolução do Drift Score por Feature",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.10 },
              { "color": "orange", "value": 0.20 },
              { "color": "red", "value": 0.30 }
            ]
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "feature_drift_score",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Dataset Drift ao Longo do Tempo",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [],
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "dataset_drift_detected",
          "legendFormat": "drift detectado",
          "refId": "A"
        },
        {
          "expr": "share_drifted_columns",
          "legendFormat": "proporção features driftadas",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 40,
      "type": "table",
      "title": "Ranking de Features com Maior Drift",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Value" }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" },
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(12, feature_drift_score)",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 50,
      "type": "timeseries",
      "title": "Comparação de Médias: Baseline vs Produção",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "description": "Compara a média das features entre dados de baseline e produção",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*baseline.*" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 5], "fill": "dash" }}]
          }
        ]
      },
      "targets": [
        {
          "expr": "feature_distribution_mean{dataset_type=\"baseline\"}",
          "legendFormat": "{{feature}} (baseline)",
          "refId": "A",
          "interval": "",
          "step": 60
        },
        {
          "expr": "feature_distribution_mean{dataset_type=\"production\"}",
          "legendFormat": "{{feature}} (produção)",
          "refId": "B",
          "interval": "",
          "step": 60
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 51,
      "type": "timeseries",
      "title": "Comparação de Desvio Padrão: Baseline vs Produção",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "description": "Compara o desvio padrão das features entre dados de baseline e produção",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*baseline.*" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 5], "fill": "dash" }}]
          }
        ]
      },
      "targets": [
        {
          "expr": "feature_distribution_std{dataset_type=\"baseline\"}",
          "legendFormat": "{{feature}} (baseline)",
          "refId": "A",
          "interval": "",
          "step": 60
        },
        {
          "expr": "feature_distribution_std{dataset_type=\"production\"}",
          "legendFormat": "{{feature}} (produção)",
          "refId": "B",
          "interval": "",
          "step": 60
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 52,
      "type": "bargauge",
      "title": "Diferença Percentual nas Médias (Produção vs Baseline)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "description": "Mostra quanto % a média de produção difere do baseline",
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 30 }
            ]
          },
          "decimals": 1
        }
      },
      "targets": [
        {
          "expr": "100 * (feature_distribution_mean{dataset_type=\"production\"} - on(feature, modelo, versao) feature_distribution_mean{dataset_type=\"baseline\"}) / on(feature, modelo, versao) feature_distribution_mean{dataset_type=\"baseline\"}",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 53,
      "type": "table",
      "title": "Resumo Estatístico: Baseline vs Produção (Latest)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "description": "Tabela comparativa com estatísticas descritivas",
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "decimals": 2
        }
      },
      "targets": [
        {
          "expr": "feature_distribution_mean",
          "legendFormat": "{{feature}} ({{dataset_type}}) - mean",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "feature_distribution_std",
          "legendFormat": "{{feature}} ({{dataset_type}}) - std",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "feature_distribution_median",
          "legendFormat": "{{feature}} ({{dataset_type}}) - median",
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 60,
      "type": "stat",
      "title": "Alertas Ativos do Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "description": "Número de alertas ativos relacionados a data drift",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\".*Drift.*\"})",
          "legendFormat": "Alertas Firing",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 61,
      "type": "table",
      "title": "Lista de Alertas Ativos",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "description": "Alertas de drift que estão firing ou pending",
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true }
        }
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=~\"firing|pending\"}",
          "legendFormat": "{{alertname}} - {{severity}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 62,
      "type": "alertlist",
      "title": "Histórico de Alertas",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "description": "Painel com lista de alertas do dashboard",
      "options": {
        "alertName": "",
        "dashboardAlerts": false,
        "alertInstanceLabelFilter": "",
        "groupBy": ["alertname"],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        },
        "folder": ""
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    }

  ],

  "schemaVersion": 38,
  "tags": ["drift", "mlops", "imoveis"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "America/Sao_Paulo",
  "title": "Data Drift — Precificação de Imóveis",
  "uid": "drift-imoveis-v1",
  "version": 1
}
